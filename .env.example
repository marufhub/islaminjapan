# ---------------------------------------------------------------------------
# Islam in Japan — environment configuration
# Copy to `.env` and fill in values. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (docker-compose provides these defaults for local development)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/islaminjapan
# Used only by integration tests (created automatically by docker/postgres-init)
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:5432/islaminjapan_test

# Long random string used by Payload to sign auth tokens. Generate with:
#   openssl rand -hex 32
PAYLOAD_SECRET=

# Public base URL of the site (used for canonical URLs, sitemap, previews)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Media storage (S3-compatible). If S3_BUCKET is empty, uploads are stored on
# local disk in ./media — fine for development, NOT for production hosting.
# For local MinIO: create the bucket in the console at http://localhost:9001
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=ap-northeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# AI Content Studio — OpenAI Responses API (server-side only; never NEXT_PUBLIC_*).
# Without OPENAI_API_KEY the Studio shows a "not configured" state.
# Verify model availability and prices for your API account at implementation time.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-6.1-sol
OPENAI_FAST_MODEL=gpt-6-luna
# Max output tokens per response (reasoning tokens count toward this limit).
AI_MAX_OUTPUT_TOKENS=6000
# Site-wide ESTIMATED monthly spend guard in USD (not the billed amount).
AI_MONTHLY_BUDGET_USD=20
# Let OpenAI store responses? Kept false for editorial drafts.
OPENAI_STORE=false
# Optional price overrides (USD per 1M tokens) for models not in the built-in table.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# ---------------------------------------------------------------------------
# Contact form email notifications (optional). Without these, inquiries are
# stored in the admin "Inquiries" queue only and no email is sent.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Islam in Japan

# Header your hosting platform sets with the real client IP (e.g. x-real-ip, cf-connecting-ip).
# Used only for contact-form rate limiting. If empty, the rightmost X-Forwarded-For entry is used.
TRUSTED_CLIENT_IP_HEADER=
# AI Studio safeguards (per CMS user)
AI_HOURLY_REQUEST_LIMIT=30
AI_DAILY_TOKEN_BUDGET=600000
AI_TIMEOUT_MS=300000

# Extra origins allowed to use the CMS session cookie (comma-separated), e.g. https://www.example.org
CSRF_EXTRA_ORIGINS=
