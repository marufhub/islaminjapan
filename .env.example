# ---------------------------------------------------------------------------
# Islam in Japan — environment configuration
# Copy to `.env` and fill in values. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (docker-compose provides these defaults for local development)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/islaminjapan
# Used only by integration tests (created automatically by docker/postgres-init)
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:5432/islaminjapan_test

# Long random string used by Payload to sign auth tokens. Generate with:
#   openssl rand -hex 32
PAYLOAD_SECRET=

# Public base URL of the site (used for canonical URLs, sitemap, previews)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Media storage (S3-compatible). If S3_BUCKET is empty, uploads are stored on
# local disk in ./media — fine for development, NOT for production hosting.
# For local MinIO: create the bucket in the console at http://localhost:9001
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=ap-northeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# AI Content Studio (Anthropic Claude). Server-side only — never exposed to the
# browser. If unset, the AI Studio shows a "not configured" state.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
